+            indent: gpui::rgb(0x505037).into(),
+            indent_active: gpui::rgb(0x707057).into(),
+            brackets: vec![
+                gpui::rgb(0xFFD700).into(),
+                gpui::rgb(0xDA70D6).into(),
+                gpui::rgb(0x179FFF).into(),
+            ],
+        }
+    }
