+    /// The document's version, following VS Code's `alternativeVersionId`:
+    /// every edit makes a new one, and undo or redo returns to the version the
+    /// document had at that step. Compare it with the version at the last save
+    /// to tell whether there are unsaved edits.
+    pub fn version(&self) -> u64 {
+        self.undo_manager.version()
+    }
+
+    /// End the current undo step, so that the next edit starts a new one
+    /// instead of merging into it; call it on save, so that undoing what is
+    /// typed afterwards returns to the saved version.
+    pub fn break_undo_coalescing(&mut self) {
+        self.undo_manager.break_transaction_coalescing();
+    }
+
+    /// Apply `(byte range in the current document, replacement)` edits as one
+    /// undo step of its own, such as reloading a file that changed on disk.
+    ///
+    /// Unlike [`replace_all`](Self::replace_all), the cursors and the scroll
+    /// position stay where they are: each selection moves with the text
+    /// around it, and one inside a replaced range moves to the replacement.
+    pub fn apply_edits(
+        &mut self,
+        edits: &[(Range<usize>, String)],
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let version = self.version();
+        let selections: Vec<CursorSelection> = self.selections.iter().copied().collect();
+        self.undo_manager.break_transaction_coalescing();
+        self.replace_text_in_ranges(edits, window, cx);
+        self.undo_manager.break_transaction_coalescing();
 
+        let mut ascending: Vec<(Range<usize>, usize)> = edits
+            .iter()
+            .map(|(range, text)| (range.clone(), text.len()))
+            .collect();
+        ascending.sort_by_key(|(range, _)| range.start);
+        let map = |offset: usize| {
+            let mut shift = 0isize;
+            for (range, inserted) in &ascending {
+                if offset <= range.start {
+                    break;
+                }
+                if offset < range.end {
+                    let start = (range.start as isize + shift) as usize;
+                    return start + (offset - range.start).min(*inserted);
+                }
+                shift += *inserted as isize - range.len() as isize;
+            }
+            (offset as isize + shift) as usize
+        };
+        let len = self.text.len();
+        let moved: Vec<CursorSelection> = selections
+            .into_iter()
+            .map(|mut selection| {
+                selection.start = map(selection.start).min(len);
+                selection.end = map(selection.end).min(len);
+                selection.column_anchor = None;
+                selection
+            })
+            .collect();
+        if self.version() != version {
+            // The step's cursors for redo, in place of one per edit.
+            self.undo_manager
+                .record_selections(Vec::new(), moved.clone());
+        }
+        self.selections.replace_all(moved);
+        self.selections.merge_overlapping();
+        self.update_preferred_column();
+        cx.notify();
+    }
