+/// A guide as VS Code draws it: a one-pixel line at the left edge of its
+/// column, or along the row's top or bottom edge up to `end`.
+fn render_guide(guide: Guide, code: &CodePresentation) -> gpui::Div {
+    let line = div()
+        .absolute()
+        .left(code.space_width * guide.column as f32)
+        .bg(guide.color);
+    let length = code.space_width * (guide.end - guide.column) as f32;
+    match guide.shape {
+        GuideShape::Vertical => line.top_0().bottom_0().w(px(1.)),
+        GuideShape::Top => line.top_0().w(length).h(px(1.)),
+        GuideShape::Bottom => line.bottom_0().w(length).h(px(1.)),
+    }
+}
