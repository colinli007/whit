+        assert_eq!(indent_levels(&indents), [0, 1, 1, 1, 1, 0]);
+        // Two-space code with indent size 4 still gets one guide per step.
+        let indents = [Some(0), Some(2), Some(4), Some(2), Some(0)];
+        assert_eq!(indent_levels(&indents), [0, 1, 1, 1, 0]);
+    }
+
+    #[test]
