+/// VS Code's `.workbench-hover-pointer`: a 5px square with a 1px border on
+/// two sides, turned to stand on the hover's edge facing `trigger`, so the
+/// bordered half points out of `hover` and its fill covers the edge below.
+/// It sits at the hover's middle, or at the trigger's when the hover was
+/// pushed aside by the window's edge.
+fn paint_pointer(
+    hover: Bounds<Pixels>,
+    trigger: Bounds<Pixels>,
+    background: Hsla,
+    border: Hsla,
+    window: &mut Window,
+) {
+    // Half the diagonal of the 6px bordered square, and of its 5px fill,
+    // whose center sits 0.5px further in on each axis.
+    let outer = 6. * std::f32::consts::FRAC_1_SQRT_2;
+    let inner = 5. * std::f32::consts::FRAC_1_SQRT_2;
+    let inset = 0.5 * std::f32::consts::SQRT_2;
+
+    let middle = hover.center().x;
+    let x = if middle >= trigger.left() && middle <= trigger.right() {
+        middle
+    } else {
+        trigger.center().x
+    };
+    let below = hover.top() >= trigger.bottom();
+    let (edge, inward) = if below {
+        (hover.top(), 1.)
+    } else {
+        (hover.bottom(), -1.)
+    };
+    let diamond = |half: f32, shift: f32| {
+        let y = edge + px(shift * inward);
+        let mut path = PathBuilder::fill();
+        path.add_polygon(
+            &[
+                point(x, y - px(half)),
+                point(x + px(half), y),
+                point(x, y + px(half)),
+                point(x - px(half), y),
+            ],
+            true,
+        );
+        path.build().ok()
+    };
+    if let Some(path) = diamond(outer, 0.) {
+        window.paint_path(path, border);
+    }
+    if let Some(path) = diamond(inner, inset) {
+        window.paint_path(path, background);
     }
 }
 
