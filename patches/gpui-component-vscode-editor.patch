+    /// The byte offset and text of each bracket token in the last parse, in
+    /// document order. Brackets inside strings and comments are part of those
+    /// tokens, not tokens of their own, so they are left out.
+    pub(crate) fn bracket_tokens(&self, brackets: &[&'static str]) -> Vec<(usize, &'static str)> {
+        let Some(tree) = &self.tree else {
+            return Vec::new();
+        };
+        let mut tokens = Vec::new();
+        let mut cursor = tree.walk();
+        'walk: loop {
+            let node = cursor.node();
+            if node.child_count() == 0 && !node.is_named() {
+                if let Some(text) = brackets.iter().find(|text| **text == node.kind()) {
+                    tokens.push((node.start_byte(), *text));
+                }
+            }
+            if cursor.goto_first_child() {
+                continue;
+            }
+            while !cursor.goto_next_sibling() {
+                if !cursor.goto_parent() {
+                    break 'walk;
+                }
+            }
+        }
+        tokens
     }
 
