{
  "name": "Monokai Dimmed",
  "author": "Whit",
  "url": "https://github.com/microsoft/vscode/blob/main/extensions/theme-monokai-dimmed/themes/dimmed-monokai-color-theme.json",
  "themes": [
    {
      "name": "Monokai Dimmed",
      "mode": "dark",
      "font.size": 13,
      "mono_font.family": "Fira Code",
      "mono_font.size": 14,
      "radius": 4,
      "colors": {
        "background": "#1E1E1E",
        "foreground": "#CCCCCC",
        "border": "#444444",
        "window.border": "#444444",
        "caret": "#C07020",
        "ring": "#3655B5",
        "selection.background": "#676B7180",
        "overlay": "#00000066",

        "muted.background": "#3C3C3C",
        "muted.foreground": "#CCCCCCB3",
        "accent.background": "#707070",
        "accent.foreground": "#FFFFFF",

        "primary.background": "#565656",
        "primary.hover.background": "#676767",
        "primary.active.background": "#676767",
        "primary.foreground": "#FFFFFF",
        "button.primary.background": "#565656",
        "button.primary.hover.background": "#676767",
        "button.primary.active.background": "#676767",
        "button.primary.foreground": "#FFFFFF",
        "secondary.background": "#3A3D41",
        "secondary.hover.background": "#45494E",
        "secondary.active.background": "#45494E",
        "secondary.foreground": "#FFFFFF",

        "input.border": "#00000000",
        "popover.background": "#272727",
        "popover.foreground": "#CCCCCC",

        "list.background": "#272727",
        "list.hover.background": "#444444",
        "list.active.background": "#4E4E4E",
        "list.active.border": "#00000000",

        "sidebar.background": "#272727",
        "sidebar.foreground": "#CCCCCC",
        "sidebar.border": "#00000000",
        "sidebar.accent.background": "#444444",
        "sidebar.accent.foreground": "#CCCCCC",

        "tab_bar.background": "#282828",
        "tab.background": "#404040",
        "tab.foreground": "#D8D8D8",
        "tab.active.background": "#1E1E1E",
        "tab.active.foreground": "#FFFFFF",
        "title_bar.background": "#505050",
        "title_bar.border": "#00000000",
        "status_bar.background": "#505050",
        "status_bar.border": "#00000000",

        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#79797966",
        "scrollbar.thumb.hover.background": "#646464B3",

        "success.background": "#2EA043",
        "success.foreground": "#FFFFFF",
        "danger.background": "#F48771",
        "danger.foreground": "#FFFFFF",
        "warning.background": "#CCA700",
        "warning.foreground": "#1E1E1E",
        "info.background": "#3794FF",
        "info.foreground": "#FFFFFF",
        "link": "#3794FF",
        "link.hover": "#3794FF",
        "link.active": "#3794FF"
      },
      "highlight": {
        "editor.background": "#1E1E1E",
        "editor.foreground": "#C5C8C6",
        "editor.active_line.background": "#303030",
        "editor.line_number": "#858585",
        "editor.active_line_number": "#949494",
        "syntax": {
          "attribute": { "color": "#D0B344" },
          "boolean": { "color": "#408080" },
          "comment": { "color": "#9A9B99" },
          "comment.doc": { "color": "#9A9B99" },
          "constant": { "color": "#6089B4" },
          "constant.builtin": { "color": "#408080" },
          "constructor": { "color": "#CE6700" },
          "embedded": { "color": "#C5C8C6" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#9B0000" },
          "function": { "color": "#CE6700" },
          "keyword": { "color": "#9872A2" },
          "keyword.operator": { "color": "#676867" },
          "link_text": { "color": "#AE81FF" },
          "number": { "color": "#6089B4" },
          "operator": { "color": "#676867" },
          "preproc": { "color": "#9872A2" },
          "property": { "color": "#9872A2" },
          "punctuation.section.embedded": { "color": "#D0B344" },
          "punctuation.special": { "color": "#D08442" },
          "string": { "color": "#9AA83A" },
          "string.escape": { "color": "#8080FF" },
          "string.regex": { "color": "#9AA83A" },
          "string.special": { "color": "#9AA83A" },
          "tag": { "color": "#6089B4" },
          "tag.component": { "color": "#C7444A" },
          "tag.doctype": { "color": "#9AA83A" },
          "text.code.span": { "color": "#FF0080" },
          "text.literal": { "color": "#FF0080" },
          "title": { "color": "#D0B344", "font_weight": 700 },
          "type": { "color": "#9B0000" },
          "type.builtin": { "color": "#C7444A" },
          "variable": { "color": "#6089B4" },
          "variable.special": { "color": "#C7444A" },
          "variant": { "color": "#6089B4" }
        }
      }
    }
  ]
}
